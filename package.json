{
  "name": "legacy-launcher",
  "version": "0.1.8",
  "description": "Launcher de escritorio para el servidor Legacy de SA-MP",
  "private": true,
  "main": "main.cjs",
  "author": "Legacy",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist:win": "electron-builder --win zip --x64 --publish never",
    "dist:installer": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "42.11.18",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.legacy.samp.launcher",
    "productName": "Legacy Launcher",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "BladimirFC",
        "repo": "legacy-launcher",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "lib/**",
      "renderer/**",
      "assets/**",
      "!assets/logo-lg.png",
      "launcher-config.json",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "README.md",
        "to": "LEEME.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false,
      "artifactName": "Legacy-Launcher-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Legacy-Launcher-${version}-Setup.${ext}",
      "include": "build/installer.nsh"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BladimirFC/legacy-launcher.git"
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  }
}
